{% extends '@OpenStudioUxShowcase/layout.html.twig' %}

{% block body %}
    {% for entry in libraries %}
        {% set library = entry.library %}
        <section class="showcase-library" aria-labelledby="library-{{ library.name }}">
            <h2 id="library-{{ library.name }}">{{ library.label }}</h2>
            {% for group in entry.groups %}
                <section class="showcase-group">
                    <h3>{{ group.name }}</h3>
                    <ul class="showcase-list">
                        {% for component in group.components %}
                            <li>
                                <a href="{{ path('ux_showcase_component', {library: library.name, component: component.name}|merge(state.carried(configuration))) }}">{{ component.label }}</a>
                                <code class="showcase-name">{{ component.name }}</code>
                                {% if component.status %}
                                    <span class="showcase-badge showcase-badge-{{ component.status.value }}">{{ ('status.' ~ component.status.value)|trans({}, 'UxShowcaseBundle') }}</span>
                                {% endif %}
                                {% if entry.without_example[component.name] is defined %}
                                    <span class="showcase-badge showcase-badge-no-example">{{ 'index.no_example'|trans({}, 'UxShowcaseBundle') }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                        {% for page in group.docPages %}
                            <li>
                                <a href="{{ path('ux_showcase_doc', {library: library.name, slug: page.slug}|merge(state.carried(configuration))) }}">{{ page.title }}</a>
                                {% if page.status %}
                                    <span class="showcase-badge showcase-badge-{{ page.status.value }}">{{ ('status.' ~ page.status.value)|trans({}, 'UxShowcaseBundle') }}</span>
                                {% endif %}
                                <span class="showcase-badge showcase-badge-doc">{{ 'index.doc_page'|trans({}, 'UxShowcaseBundle') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </section>
    {% else %}
        <p>{{ 'index.empty'|trans({}, 'UxShowcaseBundle') }}</p>
    {% endfor %}
{% endblock %}
