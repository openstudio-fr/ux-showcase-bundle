{#
    The page of a component, and of a documentation page (no component, one free example).

    Blocks a host or an add-on overrides (extend '@!OpenStudioUxShowcase/component.html.twig' from
    templates/bundles/OpenStudioUxShowcaseBundle/component.html.twig):
    - header_actions: buttons in the header of the page; `actions` holds the registered ones
    - below_preview: under the frame of each example; `view` is the example, `component` its component (null on a documentation page)
      The form to try other values (`view.try`, null for a free example) is beside the frame; see `_try.html.twig`
    - below_props: under the props table of each example, same variables
#}
{% extends '@OpenStudioUxShowcase/layout.html.twig' %}

{% set heading = component ? component.label : views[0].example.title %}
{% set viewport_width = configuration.viewports[state.viewport] %}

{% block title %}{{ heading }} - {{ configuration.title }}{% endblock %}

{% block body_class %} showcase-with-footer{% endblock %}

{% block controls %}
    <div class="showcase-controls" data-ux-showcase-controls>
        <div role="group" aria-labelledby="controls-viewport">
            <span id="controls-viewport" class="showcase-controls-label">{{ 'controls.viewport'|trans({}, 'UxShowcaseBundle') }}</span>
            {% for key, width in configuration.viewports %}
                <a class="showcase-choice" href="{{ path(self_route, self_parameters|merge({viewport: key, background: state.background})) }}" data-viewport="{{ key }}" data-width="{{ width }}"{% if key == state.viewport %} aria-current="true"{% endif %}>
                    {{ key|capitalize }}{% if width %} <span class="showcase-muted">{{ width }}px</span>{% endif %}
                </a>
            {% endfor %}
        </div>
        {% if configuration.backgrounds %}
            <div role="group" aria-labelledby="controls-background">
                <span id="controls-background" class="showcase-controls-label">{{ 'controls.background'|trans({}, 'UxShowcaseBundle') }}</span>
                <a class="showcase-choice" href="{{ path(self_route, self_parameters|merge({viewport: state.viewport})) }}" data-background=""{% if state.background is null %} aria-current="true"{% endif %}>{{ 'controls.default'|trans({}, 'UxShowcaseBundle') }}</a>
                {% for key, background in configuration.backgrounds %}
                    <a class="showcase-choice" href="{{ path(self_route, self_parameters|merge({viewport: state.viewport, background: key})) }}" data-background="{{ key }}"{% if key == state.background %} aria-current="true"{% endif %}>
                        <span class="showcase-swatch" style="background-color: {{ background.color }}"></span>{{ key|capitalize }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block body %}
    <nav class="showcase-breadcrumb" aria-label="{{ 'nav.breadcrumb'|trans({}, 'UxShowcaseBundle') }}">
        <a href="{{ path('ux_showcase_index') }}">{{ 'nav.all'|trans({}, 'UxShowcaseBundle') }}</a>
        <span aria-hidden="true">/</span>
        <span>{{ library.label }}</span>
    </nav>

    <div class="showcase-page-head">
        <h2 id="showcase-heading">{{ heading }}</h2>
        {% if component %}
            <code class="showcase-name">{{ component.name }}</code>
            {% if component.status %}
                <span class="showcase-badge showcase-badge-{{ component.status.value }}">{{ ('status.' ~ component.status.value)|trans({}, 'UxShowcaseBundle') }}</span>
            {% endif %}
        {% elseif page and page.status %}
            <span class="showcase-badge showcase-badge-{{ page.status.value }}">{{ ('status.' ~ page.status.value)|trans({}, 'UxShowcaseBundle') }}</span>
        {% endif %}
        <div class="showcase-actions">
            {% block header_actions %}
                {% for action in actions %}{% include '@OpenStudioUxShowcase/_action.html.twig' %}{% endfor %}
            {% endblock %}
        </div>
    </div>
    {% if documentation and documentation.description %}<p class="showcase-description">{{ documentation.description }}</p>{% endif %}

    {% for view in views %}
        {% set id = 'example-' ~ view.example.slug %}
        {% set has_props = component is not null and not view.example.free %}
        {# A documentation page has one example, named like the page: its header would repeat the title, unless it carries actions. #}
        {% set has_head = component is not null or views|length > 1 or view.actions is not empty %}
        <article class="showcase-example" id="{{ id }}" aria-labelledby="{{ has_head ? id ~ '-title' : 'showcase-heading' }}" data-ux-showcase-example data-title="{{ view.example.title }}">
            {% if has_head %}
            <header class="showcase-example-head">
                <h3 id="{{ id }}-title"><a href="#{{ id }}">{{ view.example.title }}</a></h3>
                <div class="showcase-actions">
                    {% for action in view.actions %}{% include '@OpenStudioUxShowcase/_action.html.twig' %}{% endfor %}
                </div>
            </header>
            {% endif %}

            <div class="showcase-preview{% if view.try %} showcase-preview-with-try{% endif %}">
                <div class="showcase-preview-main">
                    <div class="showcase-frame">
                        <iframe
                            title="{{ 'example.frame_title'|trans({'%example%': view.example.title}, 'UxShowcaseBundle') }}"
                            src="{{ view.previewUrl }}"
                            {% if view.try %}name="{{ view.try.frameName }}"{% endif %}
                            loading="lazy"
                            style="width: {{ viewport_width ? viewport_width ~ 'px' : '100%' }}{% if view.height %}; height: {{ view.height }}px{% endif %}"
                            {% if view.height %}data-fixed-height{% endif %}
                        ></iframe>
                    </div>
                    {% block below_preview %}{% endblock %}
                </div>
                {% if view.try %}{% include '@OpenStudioUxShowcase/_try.html.twig' with {try: view.try, id: id} only %}{% endif %}
            </div>

            {# Code and props: read here without JavaScript; with it, the bar at the bottom of the screen shows them in a panel. #}
            <details class="showcase-details" id="{{ id }}-code" data-ux-showcase-details="code">
                <summary>{{ 'tabs.code'|trans({}, 'UxShowcaseBundle') }}</summary>
                <div class="showcase-details-body">
                    <pre class="showcase-code"><code>{{ view.code }}</code></pre>
                </div>
            </details>

            {% if has_props %}
                <details class="showcase-details" id="{{ id }}-props" data-ux-showcase-details="props">
                    <summary>{{ 'tabs.props'|trans({}, 'UxShowcaseBundle') }}</summary>
                    <div class="showcase-details-body">
                        {% if documentation.props %}
                        <table class="showcase-table">
                            <caption class="showcase-visually-hidden">{{ 'props.caption'|trans({'%component%': component.name}, 'UxShowcaseBundle') }}</caption>
                            <thead>
                                <tr>
                                    <th scope="col">{{ 'props.name'|trans({}, 'UxShowcaseBundle') }}</th>
                                    <th scope="col">{{ 'props.type'|trans({}, 'UxShowcaseBundle') }}</th>
                                    <th scope="col">{{ 'props.default'|trans({}, 'UxShowcaseBundle') }}</th>
                                    <th scope="col">{{ 'props.description'|trans({}, 'UxShowcaseBundle') }}</th>
                                    <th scope="col">{{ 'props.required'|trans({}, 'UxShowcaseBundle') }}</th>
                                    <th scope="col">{{ 'props.allowed'|trans({}, 'UxShowcaseBundle') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for prop in documentation.props %}
                                    <tr>
                                        <th scope="row"><code>{{ prop.name }}</code></th>
                                        <td><code>{{ prop.type }}</code></td>
                                        <td>{% if prop.hasDefault %}<code>{{ prop.default|ux_showcase_value }}</code>{% else %}<span class="showcase-muted">{{ 'props.none'|trans({}, 'UxShowcaseBundle') }}</span>{% endif %}</td>
                                        <td>{{ prop.description }}</td>
                                        <td>{{ (prop.required ? 'props.yes' : 'props.no')|trans({}, 'UxShowcaseBundle') }}</td>
                                        <td>{% for value in prop.allowedValues ?? [] %}<code>{{ value|ux_showcase_value }}</code>{% if not loop.last %} {% endif %}{% endfor %}</td>
                                    </tr>
                                    {% for field in prop.fields %}
                                        <tr class="showcase-field">
                                            <th scope="row"><code>{{ prop.name }}.{{ field.name }}</code></th>
                                            <td><code>{{ field.type }}</code></td>
                                            <td></td>
                                            <td>{{ field.description }}</td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    {% endfor %}
                                {% endfor %}
                            </tbody>
                        </table>
                        {% else %}
                        <p class="showcase-muted">{{ 'props.empty'|trans({}, 'UxShowcaseBundle') }}</p>
                        {% endif %}

                        {% if documentation.blocks %}
                        <h4>{{ 'blocks.title'|trans({}, 'UxShowcaseBundle') }}</h4>
                        <ul class="showcase-blocks">
                            {% for block in documentation.blocks %}
                                <li><code>{{ block.name }}</code>{% if block.description %} <span class="showcase-muted">{{ block.description }}</span>{% endif %}</li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                        {% block below_props %}{% endblock %}
                    </div>
                </details>
            {% endif %}
        </article>
    {% else %}
        <p class="showcase-muted">{{ 'component.no_examples'|trans({}, 'UxShowcaseBundle') }}</p>
    {% endfor %}
{% endblock %}

{% block footer %}
  {% if views is not empty %}
    {% set background_names = configuration.backgrounds|keys %}
    <div class="showcase-footer" id="showcase-footer" role="region" aria-label="{{ 'footer.label'|trans({}, 'UxShowcaseBundle') }}" data-ux-showcase-footer>
        <p class="showcase-footer-current" aria-live="polite"><span class="showcase-muted">{{ 'footer.current'|trans({}, 'UxShowcaseBundle') }}</span> <strong data-current-name>{{ views[0].example.title|default('') }}</strong></p>
        <div class="showcase-footer-choice">
            <label for="footer-viewport">{{ 'controls.viewport'|trans({}, 'UxShowcaseBundle') }}</label>
            <select id="footer-viewport" data-override="viewport">
                <option value="">{{ 'footer.from_header'|trans({}, 'UxShowcaseBundle') }}</option>
                {% for key, width in configuration.viewports %}<option value="{{ key }}" data-width="{{ width }}">{{ key|capitalize }}{% if width %} {{ width }}px{% endif %}</option>{% endfor %}
            </select>
        </div>
        {% if background_names %}
        <div class="showcase-footer-choice">
            <label for="footer-background">{{ 'controls.background'|trans({}, 'UxShowcaseBundle') }}</label>
            <select id="footer-background" data-override="background">
                <option value="">{{ 'footer.from_header'|trans({}, 'UxShowcaseBundle') }}</option>
                <option value="none">{{ 'controls.default'|trans({}, 'UxShowcaseBundle') }}</option>
                {% for key in background_names %}<option value="{{ key }}">{{ key|capitalize }}</option>{% endfor %}
            </select>
        </div>
        {% endif %}
        <button type="button" class="showcase-button showcase-footer-reset" data-override-reset hidden>{{ 'footer.reset'|trans({}, 'UxShowcaseBundle') }}</button>
        <div class="showcase-footer-panels">
            <button type="button" class="showcase-button" data-panel-toggle="code" aria-expanded="false" aria-controls="showcase-panel">{{ 'tabs.code'|trans({}, 'UxShowcaseBundle') }}</button>
            {% if component %}<button type="button" class="showcase-button" data-panel-toggle="props" aria-expanded="false" aria-controls="showcase-panel">{{ 'tabs.props'|trans({}, 'UxShowcaseBundle') }}</button>{% endif %}
        </div>
    </div>
    <div class="showcase-panel" id="showcase-panel" role="dialog" aria-labelledby="showcase-panel-title" tabindex="-1" hidden data-ux-showcase-panel>
        <header class="showcase-panel-head">
            <h2 id="showcase-panel-title" data-panel-title></h2>
            <button type="button" class="showcase-button" data-panel-close>{{ 'panel.close'|trans({}, 'UxShowcaseBundle') }}</button>
        </header>
        <div class="showcase-panel-body" data-panel-body></div>
    </div>
  {% endif %}
{% endblock %}
