<article{{ attributes }} data-limit="{{ limit }}"><h2>{{ title }}</h2><p class="vehicle">{{ vehicle.name }} {{ vehicle.price|number_format(2) }} [{{ vehicle.tags|join(',') }}] {{ vehicle.layout.value }}{% if vehicle.since %} {{ vehicle.since|date('Y-m-d H:i', 'UTC') }}{% endif %}</p><ul>{% for other in others %}<li>{{ other.name }}</li>{% endfor %}</ul><i>{{ layout.value }}</i>{% block content %}{% endblock %}<time>{{ since ? since|date('Y-m-d H:i', 'UTC') : '-' }}</time></article>
