{
    "name": "openstudio/ux-showcase-bundle",
    "description": "A showcase of Twig components served by the application itself, with no Node server.",
    "type": "symfony-bundle",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/ux-twig-component": "^2.36 || ^3.0",
        "twig/twig": "^3.29"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "masterminds/html5": "^2.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/ux-live-component": "^2.36 || ^3.0"
    },
    "suggest": {
        "symfony/security-bundle": "Required to open the showcase to a Symfony role (ux_showcase.access.role)."
    },
    "autoload": {
        "psr-4": {
            "OpenStudio\\UxShowcaseBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenStudio\\UxShowcaseBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.dist.xml",
        "stan": "phpstan analyse -c phpstan.dist.neon --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
